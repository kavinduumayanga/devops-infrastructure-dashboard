# Copy this file to .env and replace every example value.
# Secrets must be at least 16 characters and may use: letters, numbers, ._@%+=:-

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_PASSWORD=replace-with-a-strong-database-password
RABBITMQ_APP_PASSWORD=replace-with-a-strong-rabbit-app-password
RABBITMQ_MONITOR_PASSWORD=replace-with-a-strong-monitor-password

# Optional branch, tag, or commit. Defaults to main when omitted.
APP_GIT_REF=main

# Optional default. Prefer setting this per command during first-time provisioning.
# VM_MEMORY_PROFILE=runtime
