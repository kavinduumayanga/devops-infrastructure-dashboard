# Environment
APP_ENV=development
# Optional override; omit to use the runtime hostname.
# APP_INSTANCE_ID=app01

# MySQL Database
# Deployed app01/app02 instances override this with DB_HOST=192.168.56.25.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=devops_demo
DB_USER=admin
DB_PASSWORD=
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT_MS=5000

# Memcached
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211
CACHE_TTL_SECONDS=60
CACHE_OPERATION_TIMEOUT_MS=3000
