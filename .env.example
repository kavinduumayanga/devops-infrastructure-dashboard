# Environment
APP_ENV=development
# Optional override; omit to use the runtime hostname.
# APP_INSTANCE_ID=app01

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=devops_demo
DB_USER=admin
DB_PASSWORD=
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT_MS=5000

# Memcached
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211
CACHE_TTL_SECONDS=60
CACHE_OPERATION_TIMEOUT_MS=3000

# Unified infrastructure monitoring (optional for local development)
INFRA_MONITORING_ENABLED=false
INFRA_MONITORING_INTERVAL_SECONDS=15
INFRA_MONITORING_TIMEOUT_MS=3000

NGINX_HEALTH_URL=http://192.168.56.20/nginx-health
APP01_HEALTH_URL=http://192.168.56.22:8080/devops-dashboard/api/instance
APP02_HEALTH_URL=http://192.168.56.21:8080/devops-dashboard/api/instance

RABBITMQ_HOST=192.168.56.23
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_URL=http://192.168.56.23:15672
RABBITMQ_VHOST=devops
RABBITMQ_MONITOR_USERNAME=
RABBITMQ_MONITOR_PASSWORD=

NFS_MOUNT_PATH=/mnt/nfs-shared
NFS_EXPECTED_SERVER=192.168.56.26
NFS_EXPECTED_EXPORT=/srv/nfs/shared
NFS_WRITE_PROBE_ENABLED=false
