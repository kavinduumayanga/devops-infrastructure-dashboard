
Vagrant.configure("2") do |config|
  config.hostmanager.enabled = true
  config.hostmanager.manage_host = true
  config.hostmanager.manage_guest = true


### NFS VM ###
  config.vm.define "nfs01" do |nfs01|
    nfs01.vm.box = "bandit145/centos_stream9_arm"
    nfs01.vm.hostname = "nfs01"
    nfs01.vm.network "private_network", ip: "192.168.56.26"

    nfs01.vm.provider "vmware_desktop" do |vmware|
      vmware.vmx["memsize"] = "384"
      vmware.vmx["numvcpus"] = "1"
      vmware.gui = true
      vmware.allowlist_verified = true
    end
  end


### DB VM ####
  config.vm.define "db01" do |db01|
    db01.vm.box = "bandit145/centos_stream9_arm"
